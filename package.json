{
  "name": "commands-open-terminal-in-editor-2",
  "displayName": "Commands: Open Terminal in Editor 2",
  "description": "Launch terminal presets in the editor area while preserving settings from the original Commands extension.",
  "icon": "media/icons/commands-2.png",
  "version": "0.1.1",
  "publisher": "ayanamist",
  "author": {
    "name": "ayanamist"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayanamist/vsc-commands.git"
  },
  "bugs": {
    "url": "https://github.com/ayanamist/vsc-commands/issues"
  },
  "homepage": "https://github.com/ayanamist/vsc-commands#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "presets",
    "commands",
    "workflow",
    "editor"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "files": [
    "dist",
    "media/icons",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "contributes": {
    "icons": {
      "commands-amp": {
        "description": "Amp CLI",
        "default": {
          "fontPath": "media/icons/commands-statusbar-icons.woff",
          "fontCharacter": "\\F107"
        }
      },
      "commands-claude": {
        "description": "Claude CLI",
        "default": {
          "fontPath": "media/icons/commands-statusbar-icons.woff",
          "fontCharacter": "\\F106"
        }
      },
      "commands-codex": {
        "description": "Codex CLI",
        "default": {
          "fontPath": "media/icons/commands-statusbar-icons.woff",
          "fontCharacter": "\\F105"
        }
      },
      "commands-copilot": {
        "description": "GitHub Copilot CLI",
        "default": {
          "fontPath": "media/icons/commands-statusbar-icons.woff",
          "fontCharacter": "\\F104"
        }
      },
      "commands-cursor": {
        "description": "Cursor CLI",
        "default": {
          "fontPath": "media/icons/commands-statusbar-icons.woff",
          "fontCharacter": "\\F103"
        }
      },
      "commands-gemini": {
        "description": "Gemini CLI",
        "default": {
          "fontPath": "media/icons/commands-statusbar-icons.woff",
          "fontCharacter": "\\F102"
        }
      },
      "commands-opencode": {
        "description": "OpenCode CLI",
        "default": {
          "fontPath": "media/icons/commands-statusbar-icons.woff",
          "fontCharacter": "\\F101"
        }
      }
    },
    "commands": [
      {
        "command": "commands.runPreset",
        "title": "Commands: Run Preset"
      },
      {
        "command": "commands.pickPreset",
        "title": "Commands: Pick Preset"
      },
      {
        "command": "commands.openEditor",
        "title": "Commands: Edit Presets"
      },
      {
        "command": "commands.enableStatusBar",
        "title": "Show in Status Bar"
      },
      {
        "command": "commands.disableStatusBar",
        "title": "Hide from Status Bar"
      },
      {
        "command": "commands.openSettingsJson",
        "title": "Commands: Edit settings.json"
      },
      {
        "command": "commands.refreshPresets",
        "title": "Commands: Refresh Presets"
      },
      {
        "command": "commands.sendShiftTab",
        "title": "Commands: Send Shift+Tab"
      },
      {
        "command": "commands.runCommandSet",
        "title": "Commands: Run Command Set"
      }
    ],
    "keybindings": [
      {
        "key": "shift+tab",
        "command": "commands.sendShiftTab",
        "when": "terminalFocus"
      }
    ],
    "configuration": {
      "title": "Commands",
      "properties": {
        "commands.presets": {
          "type": "array",
          "description": "Terminal presets shown in the Commands view.",
          "markdownDescription": "Terminal presets shown in the Commands view.\n\nExample:\n```json\n\"commands.presets\": [\n  {\n    \"id\": \"claude\",\n    \"nickname\": \"Claude\",\n    \"command\": \"claude\",\n    \"icon\": \"asset:claude\",\n    \"enabled\": true\n  }\n]\n```\n\nIcon formats: `asset:name`, `codicon:terminal`, or `file:/absolute/path/icon.svg`. The editor can copy local files into a workspace asset folder and update the icon automatically. Theme-aware assets can be provided as `name-light.svg` and `name-dark.svg` under `media/icons/`.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable id for the preset."
              },
              "nickname": {
                "type": "string",
                "description": "Label shown in the Commands view and terminal name."
              },
              "command": {
                "type": "string",
                "description": "Shell command sent to the terminal on launch."
              },
              "icon": {
                "type": "string",
                "description": "Icon source: asset:name, codicon:name, or file:/absolute/path/icon.svg."
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Whether the preset is shown and launchable."
              },
              "showInStatusBar": {
                "type": "boolean",
                "default": true,
                "description": "Show this preset as a status bar button."
              },
              "statusBarColor": {
                "type": "string",
                "description": "Optional status bar text color (CSS color or theme color id)."
              }
            },
            "required": [
              "id",
              "nickname",
              "command"
            ]
          },
          "default": [
            {
              "id": "claude",
              "nickname": "Claude",
              "command": "claude",
              "icon": "asset:claude",
              "showInStatusBar": true,
              "enabled": true
            },
            {
              "id": "codex",
              "nickname": "Codex",
              "command": "codex",
              "icon": "asset:codex",
              "showInStatusBar": true,
              "enabled": true
            },
            {
              "id": "gemini",
              "nickname": "Gemini",
              "command": "gemini",
              "icon": "asset:gemini",
              "showInStatusBar": true,
              "enabled": true
            },
            {
              "id": "claude-chrome",
              "nickname": "Claude Chrome",
              "command": "claude --chrome",
              "icon": "asset:claude",
              "showInStatusBar": true,
              "enabled": true
            },
            {
              "id": "cursor",
              "nickname": "Cursor",
              "command": "agent",
              "icon": "asset:cursor",
              "showInStatusBar": false,
              "enabled": true
            },
            {
              "id": "amp",
              "nickname": "Amp",
              "command": "amp",
              "icon": "asset:amp",
              "showInStatusBar": false,
              "enabled": true
            },
            {
              "id": "opencode",
              "nickname": "OpenCode",
              "command": "opencode",
              "icon": "asset:opencode",
              "showInStatusBar": false,
              "enabled": true
            },
            {
              "id": "copilot",
              "nickname": "Copilot",
              "command": "copilot",
              "icon": "asset:copilot",
              "showInStatusBar": false,
              "enabled": true
            }
          ]
        },
        "commands.statusBarPresets": {
          "type": "array",
          "description": "Preset ids to show in the status bar. Leave empty to show the first 3 enabled presets.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "commands.shiftTabSequence": {
          "type": "string",
          "default": "\u001b[Z",
          "description": "Escape sequence to send for Shift+Tab in Commands terminals."
        },
        "commands.sendShiftTabToTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Send Shift+Tab to the focused terminal to avoid workbench focus changes."
        },
        "commands.commandSets": {
          "type": "array",
          "description": "Command Sets launch multiple presets with one click from the status bar.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier for the command set."
              },
              "name": {
                "type": "string",
                "description": "Display name. Leave blank to auto-generate from preset names."
              },
              "presetIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Ordered list of preset IDs to launch."
              },
              "showInStatusBar": {
                "type": "boolean",
                "default": true,
                "description": "Show this command set in the status bar."
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Whether this command set is active."
              }
            },
            "required": [
              "id",
              "presetIds"
            ]
          },
          "default": [
            {
              "id": "claude-codex",
              "name": "",
              "presetIds": [
                "claude",
                "codex"
              ],
              "showInStatusBar": true,
              "enabled": true
            }
          ]
        },
        "commands.commandSetFocusFirst": {
          "type": "boolean",
          "default": true,
          "description": "Focus the first preset when launching a command set. Uncheck to focus the last preset instead."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commands",
          "title": "Commands",
          "icon": "media/icons/commands.svg"
        }
      ]
    },
    "views": {
      "commands": [
        {
          "id": "commands.presets",
          "name": "Presets"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "commands.enableStatusBar",
          "when": "view == commands.presets && viewItem == commandsPresetStatusBarOff",
          "group": "1_commands"
        },
        {
          "command": "commands.disableStatusBar",
          "when": "view == commands.presets && viewItem == commandsPresetStatusBarOn",
          "group": "1_commands"
        }
      ],
      "view/title": [
        {
          "command": "commands.openEditor",
          "when": "view == commands.presets",
          "group": "navigation"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "commands.presets",
        "contents": "[Edit presets](command:commands.openEditor) or [edit settings.json](command:commands.openSettingsJson) to customize your presets."
      }
    ]
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "copy:webview": "node -e \"require('fs').cpSync('src/webview', 'dist/webview', { recursive: true })\"",
    "build:icon-font": "node scripts/build-icon-font.mjs",
    "compile": "npm run clean && tsc --project tsconfig.json && npm run copy:webview",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "1.95.0",
    "fast-xml-parser": "^5.10.1",
    "svg2ttf": "^6.1.0",
    "svgpath": "^2.6.0",
    "ttf2woff": "^3.0.0",
    "typescript": "^5.5.4"
  }
}
